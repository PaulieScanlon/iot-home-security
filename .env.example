ANTHROPIC_API_KEY=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_KEY=

# Public URL of the Mastra server, used for media links and by scripts/
MASTRA_SERVER_URL=http://localhost:4111

# Only used by scripts/ to send test webhooks. RingSignals gets device and account IDs from Ring.
RING_DEVICE_ID=
RING_ACCOUNT_ID=
# Optional: timestamps (epoch ms) of real events, so the test scripts get a real snapshot and clip
RING_BUTTON_PRESS_TIMESTAMP=
RING_MOTION_TIMESTAMP=

# Optional: Mastra server the thread viewer in src/app subscribes to
VITE_MASTRA_URL=http://localhost:4111
